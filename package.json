{
  "name": "crdt-shared-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first collaborative Kanban workspace powered by a from-scratch state-based CRDT sync engine.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n web,sync -c cyan,magenta \"next dev\" \"tsx watch server/index.ts\"",
    "dev:web": "next dev",
    "dev:server": "tsx watch server/index.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "concurrently -k -n web,sync \"next start\" \"node dist/server/index.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^3.23.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
